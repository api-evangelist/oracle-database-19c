          "info": {
            "name": "Execute SQL",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{host}:{port}/ords/:schema/_/sql",
            "params": [
              {
                "name": "schema",
                "value": "",
                "type": "path",
                "description": "ORDS-enabled schema alias"
              }
